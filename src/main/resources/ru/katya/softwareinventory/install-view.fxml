<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.katya.softwareinventory.InstallController" prefWidth="350">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="%install.header" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
    <Label text="%install.desc" wrapText="true" textAlignment="CENTER"/>

    <GridPane hgap="10" vgap="10">
        <Label text="%install.soft_id" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="softwareIdField" text="1" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="%install.room_id" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="roomIdField" text="1" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <Button fx:id="runInstallBtn" text="%install.btn_run" onAction="#onStartInstall" prefWidth="250"
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
    <Button text="%install.btn_cancel" onAction="#onClose" prefWidth="250"/>
</VBox>