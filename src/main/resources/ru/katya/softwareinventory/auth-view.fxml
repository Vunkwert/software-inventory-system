<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.katya.softwareinventory.AuthController" prefWidth="350" prefHeight="250">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Используем ключ %auth.header вместо "Вход в систему" -->
    <Label text="%auth.header">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <TextField fx:id="usernameField" promptText="%auth.login" />
    <PasswordField fx:id="passwordField" promptText="%auth.pass" />

    <Button fx:id="loginBtn" text="%auth.button" onAction="#onLoginButtonClick" prefWidth="150" style="-fx-base: #2ecc71;"/>

    <Label fx:id="errorLabel" textFill="RED" />
</VBox>